<Project Sdk="Microsoft.NET.Sdk">

    <!-- Тесты без Revit API: файлы Core подключаются ссылками, поэтому проекту не нужен Revit SDK.
         Это же проверяет, что в Core нет зависимостей от Revit. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\Alexpivo394.Revit.Export.Sources\Alexpivo394.Revit.Export.Sources.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\source\Alexpivo394.Revit.Export\Core\**\*.cs" Link="Linked\Core\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>

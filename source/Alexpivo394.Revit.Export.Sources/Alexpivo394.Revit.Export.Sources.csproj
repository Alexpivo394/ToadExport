<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net47 — Revit 2020, он же подходит Revit 2021–2024 (net48) -->
        <TargetFrameworks>net47;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>Alexpivo394.Revit.Export.Sources</PackageId>
        <Description>Revit model sources without the Revit API: Revit Server REST tree, folder tree, .rvt version reader.</Description>
        <PackageTags>revit;autodesk;revit-server</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="OpenMcdf"/>
    </ItemGroup>

    <!-- HttpClient для REST API Revit Server; на .NET входит в рантайм -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

</Project>

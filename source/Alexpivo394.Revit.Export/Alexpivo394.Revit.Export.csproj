<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <!-- Fallback Revit version for design-time evaluation; a Debug.Rxx / Release.Rxx build overrides it -->
    <PropertyGroup>
        <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Configurations>Debug.R20;Debug.R21;Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R20;Release.R21;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
        <IsPackable>true</IsPackable>
        <PackageId>Alexpivo394.Revit.Export</PackageId>
        <Description>UI-free Revit model export to RVT and NWC: detached opening, link handling, cleanup, NWC export, local copy creation.</Description>
        <PackageTags>revit;autodesk;export;nwc;rvt</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit"/>
        <PackageReference Include="Nice3point.Revit.Extensions"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"/>
    </ItemGroup>

</Project>
